# Local development only. Render supplies its private PostgreSQL connection URL.
DATABASE_URL=sqlite:///data/connectiq.db
APP_ENV=development
ADMIN_EMAIL=
# Generate interactively: python -m connectiq.cli password
ADMIN_PASSWORD_HASH=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
STREAMLIT_SERVER_COOKIE_SECRET=
DEFAULT_TIMEZONE=Asia/Kolkata
COMPANY_CSV_PATH=data/companies.csv
SESSION_HOURS=8
LOG_LEVEL=INFO
